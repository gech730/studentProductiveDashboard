# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/studentDb
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/studentDb?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/studentDb?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=https://your-frontend-domain.com
